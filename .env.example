# Copy this file to .env and fill in your actual Supabase project values.
# Never commit the real .env file — it's already covered by .gitignore's "Environments" section.

DEBUG=True
SECRET_KEY=change-me-to-a-random-string

# Supabase Postgres connection (Project Settings -> Database -> Connection info)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
